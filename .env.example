# ==========================================================
# DocuMorph Production Environment Configuration Template
# ==========================================================

# 1. AI Vision Engine (Google AI Studio / Gemini)
GEMINI_API_KEY=AIzaSy...

# 2. Database Engine (Neon Serverless PostgreSQL)
# When set, DocuMorph switches automatically from local SQLite WAL to Neon PostgreSQL with SKIP LOCKED queueing.
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Internal Admin & Telemetry Security (Owner Access)
# Used for /api/internal/admin-auth/login and protected JWT authorization.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here
ADMIN_SECRET_KEY=generate_a_random_32_byte_secret_hex_here

# 4. Storage Backend (Optional - Defaults to Local Filesystem)
# To use Cloudflare R2 zero-egress object storage:
# CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
# CLOUDFLARE_R2_BUCKET=documorph-files

# 5. Service Tuning (Optional)
# DISABLE_EMBEDDED_WORKER=true  # Set to true only if running queue_worker in a dedicated container